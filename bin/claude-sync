#!/usr/bin/env bash
# claude-sync entrypoint. Command surface: docs/SPEC.md §20.
set -Eeuo pipefail
if ! (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )); then
  printf 'claude-sync: bash >= 4.4 required (have %s)\n' "$BASH_VERSION" >&2
  exit 1
fi
shopt -s inherit_errexit

cs_src=${BASH_SOURCE[0]}
case $cs_src in
  # a Windows task passes "C:\...\bin\claude-sync" (backslashes only): cut at either separator
  */* | *\\*) cs_bin_dir=${cs_src%[/\\]*} ;;
  *) cs_bin_dir=. ;;
esac
CS_APP_DIR=$(cd -- "$cs_bin_dir/.." && pwd -P)
unset cs_src cs_bin_dir

# shellcheck source=lib/core.sh
source "$CS_APP_DIR/lib/core.sh"

cs_usage() {
  cs_say usage
}

cs_use() {
  local m
  for m in "$@"; do
    # shellcheck source=/dev/null
    source "$CS_APP_DIR/lib/$m.sh"
  done
}


cmd_doctor() {
  cs_use platform version manifest store claude transform projects drive root ui scheduler hooks doctor
  cs_store_init
  cs_doctor
}

cmd_login() {
  cs_use platform version drive
  local client=
  while (($#)); do
    case $1 in
      --client)
        client=${2:-}
        shift 2 || cs_die_t "$CS_EXIT_USAGE" cli.unknown_command "login --client"
        ;;
      *) cs_die_t "$CS_EXIT_USAGE" cli.unknown_command "login $1" ;;
    esac
  done
  mkdir -p -- "$CS_HOME"
  if [[ -n $client ]]; then
    cs_client_install "$client"
    cs_say auth.client_installed "$(cs_client_file)"
  fi
  cs_auth_login || exit "$?"
  local who
  if who=$(cs_drive_whoami 2>/dev/null) && [[ -n $who ]]; then
    cs_say auth.signed_in_as "$who"
  else
    cs_say auth.signed_in
  fi
}

cmd_setup() {
  cs_use platform version manifest store claude transform projects drive root status engine bundle memory gc cmd_projects ui pending fork scheduler hooks repair doctor setup
  cs_setup "$@"
}

cmd_folder() {
  local sub=${1:-show}
  [[ $sub == show ]] || cs_die_t "$CS_EXIT_USAGE" cli.unknown_command "folder $sub"
  cs_use platform version store claude drive root
  local rid name who machines
  rid=$(cs_config_get root_id "")
  [[ -n $rid ]] || cs_die_t "$CS_EXIT_ERROR" folder.not_set
  cs_root_check || cs_die_t "$CS_EXIT_ERROR" folder.missing "$rid"
  name=$(drv_get_meta "$rid" | cs_jq -r .name)
  who=$(drv_about_user 2>/dev/null) || who='?'
  cs_say setup.root_summary "$who" "$name" "$(cs_root_link "$rid")"
  machines=$(cs_machines_list "$rid") || machines=
  if [[ -n $machines ]]; then
    while IFS=$'\t' read -r m nm os; do printf '    %s (%s) %s\n' "$nm" "$os" "$m"; done <<<"$machines"
  else
    cs_say setup.no_machines
  fi
}

cmd_logout() {
  cs_use platform version drive
  cs_auth_logout
  cs_say auth.logged_out
}

main() {
  case ${1:-help} in
    --version | version)
      printf 'claude-sync %s\n' "$CS_VERSION"
      return 0
      ;;
    -h | --help | help)
      cs_bootstrap_ui
      cs_usage
      return 0
      ;;
  esac

  local cmd=$1
  shift
  case $cmd in
    doctor)
      cs_bootstrap
      cmd_doctor "$@"
      ;;
    projects)
      cs_bootstrap
      cs_use platform version manifest store claude transform projects ui cmd_projects status pending
      cs_store_init
      cmd_projects "$@"
      ;;
    login)
      cs_bootstrap
      cmd_login "$@"
      ;;
    logout)
      cs_bootstrap
      cmd_logout "$@"
      ;;
    setup)
      cs_bootstrap
      cmd_setup "$@"
      ;;
    install)
      cs_bootstrap
      cs_use platform version store scheduler ui install
      cs_install "$@"
      ;;
    google)
      cs_bootstrap
      cs_use platform version store drive ui cmd_google
      cmd_google "$@"
      ;;
    reset)
      cs_bootstrap
      cs_use platform version store drive root ui reset
      cs_reset "$@"
      ;;
    folder)
      cs_bootstrap
      cmd_folder "$@"
      ;;
    repair)
      cs_bootstrap
      cs_use platform version store claude transform projects ui repair
      cs_repair "$@"
      ;;
    run | sync)
      local a
      for a in "$@"; do [[ $a == --trigger=* ]] && CS_TRIGGER=${a#--trigger=}; done
      cs_bootstrap
      cs_use platform version manifest store claude transform projects drive root status engine bundle memory gc cmd_projects ui pending fork
      cs_run "$@"
      ;;
    restore)
      cs_bootstrap
      cs_use platform version manifest store claude transform projects drive root status engine bundle memory gc cmd_projects ui pending fork
      cs_restore "$@"
      ;;
    status)
      cs_bootstrap
      cs_use platform version store status ui
      cs_status_show "$@"
      ;;
    logs)
      cs_bootstrap
      cs_use platform version store status
      cs_logs "$@"
      ;;
    machines)
      cs_bootstrap
      cs_use platform version manifest store claude transform projects drive root status engine bundle memory gc cmd_projects ui pending fork ui
      cs_machines "$@"
      ;;
    conflicts)
      cs_bootstrap
      cs_use platform version manifest store claude transform projects drive root status engine bundle memory gc cmd_projects ui pending fork
      cs_conflicts "$@"
      ;;
    service | kick)
      cs_bootstrap
      cs_use platform store scheduler ui
      if [[ $cmd == kick ]]; then cs_kick; else cs_service "$@"; fi
      ;;
    config)
      cs_bootstrap
      cs_use platform store scheduler ui cmd_config
      cmd_config "$@"
      ;;
    hooks)
      cs_bootstrap
      cs_use platform version store claude transform projects status scheduler ui hooks
      cmd_hooks "$@"
      ;;
    hook)
      cs_bootstrap
      cs_use platform version store claude transform projects status scheduler ui hooks
      cs_hook "$@"
      ;;
    claude)
      cs_bootstrap
      cs_use platform version manifest store claude transform projects ui cmd_projects status pending wrapper
      cs_claude_wrapper "$@"
      ;;
    uninstall)
      cs_bootstrap
      cs_use platform version store claude scheduler hooks ui uninstall
      cs_uninstall "$@"
      ;;
    UNINSTALL_PLACEHOLDER)
      cs_bootstrap
      cs_die_t "$CS_EXIT_ERROR" cli.not_implemented "$cmd"
      ;;
    *)
      cs_bootstrap_ui
      printf 'claude-sync: %s\n\n' "$(cs_t cli.unknown_command "$cmd")" >&2
      cs_usage >&2
      return "$CS_EXIT_USAGE"
      ;;
  esac
}

main "$@"

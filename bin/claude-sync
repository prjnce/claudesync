#!/usr/bin/env bash
# claude-sync entrypoint. Command surface: docs/SPEC.md §20.
set -Eeuo pipefail
if ! (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )); then
  printf 'claude-sync: bash >= 4.4 required (have %s)\n' "$BASH_VERSION" >&2
  exit 1
fi
shopt -s inherit_errexit

cs_src=${BASH_SOURCE[0]}
case $cs_src in
  */*) cs_bin_dir=${cs_src%/*} ;;
  *) cs_bin_dir=. ;;
esac
CS_APP_DIR=$(cd -- "$cs_bin_dir/.." && pwd -P)
unset cs_src cs_bin_dir

# shellcheck source=lib/core.sh
source "$CS_APP_DIR/lib/core.sh"

cs_usage() {
  cs_say usage
}

cs_use() {
  local m
  for m in "$@"; do
    # shellcheck source=/dev/null
    source "$CS_APP_DIR/lib/$m.sh"
  done
}

# cs_human_bytes N -> 1.2 MB style.
cs_human_bytes() {
  "$CS_AWK" -v b="$1" 'BEGIN { split("B KB MB GB TB", u, " "); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d %s\n" : "%.1f %s\n"), b, u[i] }'
}

cmd_projects() {
  local sub=${1:-list}
  case $sub in
    list)
      cs_use platform claude
      local slug n bytes cwd
      printf '%s %s %s %s\n' "$(cs_pad "$(cs_t projects.col_sessions)" 8)" "$(cs_pad "$(cs_t projects.col_size)" 10)" \
        "$(cs_pad "$(cs_t projects.col_cwd)" 50)" "$(cs_t projects.col_dir)"
      while IFS=$'\t' read -r slug n bytes cwd; do
        [[ -n $slug ]] || continue
        printf '%s %s %s %s\n' "$(cs_pad "$n" 8)" "$(cs_pad "$(cs_human_bytes "$bytes")" 10)" "$(cs_pad "$cwd" 50)" "$slug"
      done < <(cs_claude_projects_report)
      ;;
    *) cs_die_t "$CS_EXIT_ERROR" cli.not_implemented "projects $sub" ;;
  esac
}

# doctor_line TAG KEY [ARGS...]: "  TAG   message" (tags stay untranslated).
doctor_line() {
  local tag=$1
  shift
  printf '  %-5s %s\n' "$tag" "$(cs_t "$@")"
}

cmd_doctor() {
  cs_use platform claude
  local problems=0 dir scan n dirs junk dups os=$CS_OS
  ((CS_WSL)) && os+=' (WSL)'
  cs_say doctor.title "$CS_VERSION"
  doctor_line OK doctor.env "$BASH_VERSION" "$CS_AWK" "$os"
  dir=$(cs_claude_dir)
  if [[ -d $dir ]]; then
    doctor_line OK doctor.claude_dir "$dir"
  else
    doctor_line FAIL doctor.claude_dir_missing "$dir"
    return 1
  fi
  scan=$(cs_claude_scan)
  n=$(printf '%s' "$scan" | grep -c . || true)
  dirs=$(printf '%s\n' "$scan" | "$CS_AWK" -F'\t' 'NF { d[$1] = 1 } END { print length(d) + 0 }')
  doctor_line OK doctor.sessions "$n" "$dirs"
  doctor_line OK doctor.retention "$(cs_claude_retention_days)"
  junk=$(cs_claude_junk_dirs)
  if [[ -n $junk ]]; then
    while IFS= read -r d; do doctor_line WARN doctor.junk_dir "$d"; done <<<"$junk"
    problems=1
  fi
  dups=$(printf '%s\n' "$scan" | cs_claude_dup_ids /dev/stdin)
  if [[ -n $dups ]]; then
    doctor_line WARN doctor.dup_ids "$(printf '%s\n' "$dups" | grep -c .)"
    problems=1
  fi
  printf '\n'
  if ((problems)); then
    cs_say doctor.problems
    return 1
  fi
  cs_say doctor.ok
}

main() {
  case ${1:-help} in
    --version | version)
      printf 'claude-sync %s\n' "$CS_VERSION"
      return 0
      ;;
    -h | --help | help)
      cs_bootstrap_ui
      cs_usage
      return 0
      ;;
  esac

  local cmd=$1
  shift
  case $cmd in
    doctor)
      cs_bootstrap
      cmd_doctor "$@"
      ;;
    projects)
      cs_bootstrap
      cmd_projects "$@"
      ;;
    setup | login | logout | folder | sync | run | status | conflicts | restore | repair | \
      service | hooks | config | machines | claude | logs | uninstall | kick)
      cs_bootstrap
      cs_die_t "$CS_EXIT_ERROR" cli.not_implemented "$cmd"
      ;;
    *)
      cs_bootstrap_ui
      printf 'claude-sync: %s\n\n' "$(cs_t cli.unknown_command "$cmd")" >&2
      cs_usage >&2
      return "$CS_EXIT_USAGE"
      ;;
  esac
}

main "$@"
